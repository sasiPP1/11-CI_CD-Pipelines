# Runtime configuration for the IoT backend on the target server.
# Copy this file to `.env` on the server and fill in real values.
# `.env` is gitignored — never commit it.

# Docker Hub namespace used for the image pushed by .github/workflows/cd.yml
# Must match the image tag: <DOCKERHUB_USERNAME>/iot-api:latest
DOCKERHUB_USERNAME=your_dockerhub_username

# Host port published to the public internet (Pi Pico / Postman hit this port).
# The container always listens on 3000; only the host side is configurable.
HOST_PORT=3000